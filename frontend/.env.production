# Production API URL
#
# Sengaja dikosongkan. Kode di BaseLayout.astro & pages/*.astro sudah
# fallback ke '' kalau var ini kosong, sehingga fetch di browser jadi
# path relatif (mis. "/api/v1/products") — otomatis mengikuti domain
# yang sedang dibuka pengunjung (lexaastore.cloud), lalu diteruskan oleh
# Nginx (lihat nginx/default.ssl.conf, location /api/) ke backend:8080.
#
# Kalau suatu saat backend dipindah ke subdomain terpisah (mis. api.lexaastore.cloud
# TANPA proxy /api/ di depan), isi baris ini dengan origin-nya saja (TANPA
# trailing "/api", karena kode sudah menambahkan "/api/v1/..." sendiri):
# PUBLIC_API_URL=https://api.lexaastore.cloud
PUBLIC_API_URL=

