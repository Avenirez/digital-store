---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Lexaa Store adalah platform yang menyediakan layanan pembelian akun digital premium secara instan, aman, dan terpercaya dengan sistem pengiriman otomatis.' } = Astro.props;
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
---

<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#faf0e6" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,400..800;1,400..800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <title>{title && title !== 'Beranda' && title !== 'Lexaa Store' ? `${title} — Lexaa Store` : 'Lexaa Store'}</title>

  <style is:global>
    /* Custom scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #faf0e6; }
    ::-webkit-scrollbar-thumb { background: #dcc8b8; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #c5ad9b; }

    /* Glass effect utility */
    html.light .glass {
      background: rgba(250, 240, 230, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(184, 133, 108, 0.15);
    }
    html.dark .glass {
      background: rgba(18, 14, 11, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(61, 45, 34, 0.4);
    }

    /* Glow effect */
    .glow {
      box-shadow: 0 0 20px rgba(184, 133, 108, 0.12),
                  0 0 60px rgba(184, 133, 108, 0.05);
    }

    .glow-sm {
      box-shadow: 0 4px 20px rgba(61, 48, 37, 0.06);
    }

    /* Gradient text */
    .text-gradient {
      background: linear-gradient(135deg, #87533d, #b8856c, #87533d);
      background-size: 200% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Animated border gradient */
    .border-gradient {
      position: relative;
      background: #faf0e6;
      border-radius: 12px;
    }
    .border-gradient::before {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: 13px;
      background: linear-gradient(135deg, #b8856c, #e4cdb7, #b8856c);
      z-index: -1;
    }

    /* Smooth page transitions */
    html { scroll-behavior: smooth; }
    
    /* ========================================================
       DESIGN SYSTEM & THEME ARCHITECTURE
       ======================================================== */

    /* ☀️ LIGHT MODE SPECS */
    html.light body {
      font-family: 'Epilogue', system-ui, sans-serif;
      background-color: #faf0e6;
      color: #1c1510;
    }

    /* 🌙 DARK MODE SPECS */
    html.dark body { 
      font-family: 'Epilogue', system-ui, sans-serif;
      background-color: #120e0b;
      color: #f5eae1;
    }

    /* Instant smooth theme transition for container elements */
    body, header, footer, card {
      transition: background-color 0.4s ease, border-color 0.4s ease, color 0.4s ease;
    }

    /* ========================================================
       DARK / LIGHT MODE — CENTER-OUT "WAVE" TRANSITION
       Powered by the View Transitions API. The whole page is
       screenshotted before and after the class swap; the "new"
       snapshot is revealed through an expanding circle centered
       on the viewport, like a ripple spreading outward.
       ======================================================== */

    /* While a wave transition is in flight, kill the ambient per-element
       color transition above — otherwise the "new" snapshot the browser
       captures would freeze mid-crossfade instead of showing final colors. */
    html.theme-wave-active *,
    html.theme-wave-active *::before,
    html.theme-wave-active *::after {
      transition: none !important;
    }

    ::view-transition-group(root),
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
      mix-blend-mode: normal;
      pointer-events: none;
    }

    ::view-transition-old(root) {
      z-index: 1;
    }

    ::view-transition-new(root) {
      z-index: 2;
      clip-path: circle(0% at 50% 50%);
      animation: theme-wave-reveal 1.2s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }

    @keyframes theme-wave-reveal {
      to {
        clip-path: circle(100% at 50% 50%);
      }
    }

    /* Users who've asked for less motion still get the instant swap above,
       but guard here too in case a transition is already mid-flight. */
    @media (prefers-reduced-motion: reduce) {
      ::view-transition-new(root) {
        animation-duration: 0.001s;
      }
    }
  </style>

  <script is:inline>
    // Init theme from localStorage or default to dark mode on first visit
    const savedTheme = localStorage.getItem('theme') || 'dark';
    if (savedTheme === 'dark') {
      document.documentElement.classList.add('dark');
      document.documentElement.classList.remove('light');
    } else {
      document.documentElement.classList.add('light');
      document.documentElement.classList.remove('dark');
    }

    // Flips the theme class + persists it. This is the actual state change;
    // everything in toggleTheme() below is just *how* it's revealed on screen.
    function applyTheme() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    }

    // Theme toggle with a center-out "wave" reveal (see the
    // ::view-transition-old/new(root) rules above). Falls back to the
    // instant swap on browsers without View Transitions support, or when
    // the user prefers reduced motion.
    window.toggleTheme = function() {
      const supportsViewTransitions = typeof document.startViewTransition === 'function';
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!supportsViewTransitions || prefersReducedMotion) {
        applyTheme();
        return;
      }

      document.documentElement.classList.add('theme-wave-active');
      const transition = document.startViewTransition(() => applyTheme());
      transition.finished.finally(() => {
        document.documentElement.classList.remove('theme-wave-active');
      });
    };
  </script>
</head>
<body class="min-h-screen bg-[#faf0e6] dark:bg-[#120e0b] text-[#1c1510] dark:text-[#f5eae1] antialiased transition-colors duration-300">
  <!-- Background grid pattern for linen theme -->
  <div class="fixed inset-0 bg-grid-pattern bg-grid opacity-20 dark:opacity-10 pointer-events-none" aria-hidden="true"></div>
  
  <!-- Ambient soft warm glow blobs -->
  <div class="fixed top-0 left-1/4 w-96 h-96 bg-[#e6d0bf]/40 dark:bg-[#b8856c]/10 rounded-full blur-[120px] pointer-events-none" aria-hidden="true"></div>
  <div class="fixed bottom-0 right-1/4 w-96 h-96 bg-[#d9bdab]/30 dark:bg-[#87533d]/10 rounded-full blur-[120px] pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10">
    <slot name="header" />
    <main class="min-h-[calc(100vh-160px)]">
      <slot />
    </main>
    <slot name="footer" />
  </div>

  <!-- Floating Telegram Support Button (Nomor 3) -->
  <a
    href="https://t.me/phoeeeniiiiix"
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-6 right-6 z-50 flex items-center gap-2.5 px-4 py-3 rounded-full bg-[#24A1DE] hover:bg-[#1d8dc4] text-white font-extrabold text-xs shadow-xl shadow-[#24A1DE]/30 cursor-pointer select-none"
    id="telegram-cs-float"
    style="transition: transform 0.2s ease, background-color 0.2s ease;"
  >
    <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center shrink-0">
      <svg class="w-4 h-4 text-white fill-current" viewBox="0 0 24 24">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.2-.08-.06-.19-.04-.27-.02-.12.02-1.96 1.25-5.54 3.69-.52.36-1 .54-1.42.53-.47-.01-1.37-.26-2.03-.48-.82-.27-1.47-.42-1.42-.88.03-.24.37-.49 1.02-.75 3.99-1.74 6.66-2.89 8.01-3.46 3.81-1.6 4.6-1.88 5.12-1.89.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.13-.03.22z"/>
      </svg>
    </div>
    <span class="pr-0.5">Butuh Bantuan?</span>
  </a>

  <script define:vars={{ API_URL }}>
    // Make API URL globally available
    window.__API_URL__ = API_URL;
  </script>
</body>
</html>
