---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CopyBox from '../components/CopyBox.astro';
---

<BaseLayout title="Lacak Pesanan" description="Lacak status pesanan dan lihat detail akun Anda.">
  <Header slot="header" />

  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-12">
    <div class="text-center mb-10 animate-fade-in">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-[#87533d] dark:text-[#faf0e6] mb-3">Lacak Pesanan</h1>
      <p class="text-[#9e644c] dark:text-[#e5d4c5] text-sm font-medium">Masukkan Nomor Pesanan dan PIN Keamanan Anda untuk melihat status pesanan</p>
    </div>

    <!-- Lookup Form -->
    <div class="p-6 rounded-xl bg-[#ffffff]/90 dark:bg-[#1c1510]/95 border border-[#e5d4c5] dark:border-[#3d2d22] mb-8 animate-slide-up shadow-sm">
      <form id="lookup-form" class="space-y-4">
        <div>
          <label for="order_id" class="block text-xs font-black text-[#2b1f17] dark:text-[#faf0e6] mb-1.5">Nomor Pesanan</label>
          <input
            type="text"
            id="order_id"
            name="order_id"
            required
            placeholder="DS-1234567890"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#faf0e6] dark:bg-[#2b1f17] border border-[#e5d4c5] dark:border-[#3d2d22] text-sm text-[#4d3a2c] dark:text-[#faf0e6] placeholder:text-[#9e644c]/70 dark:placeholder:text-[#b8856c]/60 focus:outline-none focus:border-[#87533d] focus:ring-1 focus:ring-[#87533d]/30 transition-all font-bold"
          />
        </div>
        <div>
          <label for="pin" class="block text-xs font-black text-[#2b1f17] dark:text-[#faf0e6] mb-1.5">PIN Keamanan</label>
          <input
            type="password"
            id="pin"
            name="pin"
            required
            maxlength="6"
            pattern="[0-9]{6}"
            inputmode="numeric"
            placeholder="Contoh: 123456"
            class="w-full px-3.5 py-2.5 rounded-lg bg-[#faf0e6] dark:bg-[#2b1f17] border border-[#e5d4c5] dark:border-[#3d2d22] text-sm text-[#4d3a2c] dark:text-[#faf0e6] placeholder:text-[#9e644c]/70 dark:placeholder:text-[#b8856c]/60 focus:outline-none focus:border-[#87533d] focus:ring-1 focus:ring-[#87533d]/30 transition-all font-bold tracking-widest"
          />
        </div>
        <button
          type="submit"
          id="lookup-btn"
          class="btn-solid w-full py-3 rounded-xl bg-gradient-to-r from-[#87533d] to-[#b8856c] !text-[#faf0e6] font-extrabold text-sm hover:from-[#6f4332] hover:to-[#a36d54] shadow-lg shadow-[#87533d]/20 transition-all duration-300 disabled:opacity-50"
        >
          Cari Pesanan
        </button>
      </form>
    </div>

    <!-- Error -->
    <div id="lookup-error" class="hidden mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 animate-fade-in">
      <p class="text-sm text-rose-700 flex items-center gap-2" id="lookup-error-text">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
        <span></span>
      </p>
    </div>

    <!-- Results -->
    <div id="lookup-results" class="hidden space-y-6 animate-slide-up">
      <!-- Order Status Card -->
      <div class="p-6 rounded-xl bg-[#ffffff]/90 border border-[#e5d4c5] shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-[#1c1510]">Detail Pesanan</h2>
          <span id="status-badge" class="px-3 py-1 rounded-full text-xs font-semibold"></span>
        </div>
        <div class="space-y-3 text-sm">
          <div class="flex justify-between">
            <span class="text-[#5c4a3b] dark:text-[#b8856c] font-medium">Nomor Pesanan</span>
            <span class="text-[#1c1510] dark:text-[#faf0e6] font-mono font-bold" id="result-order-number"></span>
          </div>
          <div class="flex justify-between">
            <span class="text-[#5c4a3b] dark:text-[#b8856c] font-medium">Produk</span>
            <span class="text-[#1c1510] dark:text-[#faf0e6] font-bold text-right" id="result-product-name">-</span>
          </div>
          <div class="flex justify-between">
            <span class="text-[#5c4a3b] dark:text-[#b8856c] font-medium">Jumlah / Qty</span>
            <span class="text-[#1c1510] dark:text-[#faf0e6] font-bold" id="result-quantity">-</span>
          </div>
          <div class="flex justify-between">
            <span class="text-[#5c4a3b] dark:text-[#b8856c] font-medium">Total</span>
            <span class="text-[#87533d] dark:text-[#e4cdb7] font-bold" id="result-total"></span>
          </div>
          <div class="flex justify-between">
            <span class="text-[#5c4a3b] dark:text-[#b8856c] font-medium">Tanggal</span>
            <span class="text-[#1c1510] dark:text-[#faf0e6] font-medium" id="result-date"></span>
          </div>
        </div>
      </div>

      <!-- Credentials Section (shown only for PAID orders) -->
      <div id="credentials-section" class="hidden">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
          <h2 class="text-lg font-bold text-[#1c1510]">Informasi Akun</h2>
          <div class="flex items-center gap-2">
            <button
              id="copy-all-btn"
              class="px-3.5 py-2 rounded-lg bg-[#faf0e6] dark:bg-[#2b1f17] border border-[#e5d4c5] dark:border-[#3d2d22] text-xs font-bold text-[#87533d] dark:text-[#faf0e6] hover:bg-[#e4cdb7] dark:hover:bg-[#38291f] transition-all flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5 text-[#87533d] dark:text-[#b8856c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
              </svg>
              <span>Salin Semua Akun</span>
            </button>
            <button
              id="download-btn"
              class="px-3.5 py-2 rounded-lg bg-[#f3e3d3] dark:bg-[#3d2d22] border border-[#e5d4c5] dark:border-[#4d3a2c] text-xs font-bold text-[#1c1510] dark:text-[#faf0e6] hover:bg-[#e4cdb7] dark:hover:bg-[#4d3a2c] transition-all flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5 text-[#5c4a3b] dark:text-[#b8856c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              Download .txt
            </button>
          </div>
        </div>
        <div id="credentials-list" class="space-y-3">
          <!-- Dynamically populated -->
        </div>
      </div>

      <!-- Pending message -->
      <div id="pending-section" class="hidden p-6 rounded-xl bg-amber-50 border border-amber-200">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-amber-700 animate-pulse-soft" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-bold text-amber-900">Menunggu Pembayaran</p>
            <p class="text-xs text-amber-800/80 mt-0.5">Selesaikan pembayaran dalam 15 menit sebelum pesanan kedaluwarsa.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const form = document.getElementById('lookup-form') as HTMLFormElement;
  const btn = document.getElementById('lookup-btn') as HTMLButtonElement;
  const errorEl = document.getElementById('lookup-error');
  const errorText = document.getElementById('lookup-error-text')?.querySelector('span');
  const resultsEl = document.getElementById('lookup-results');
  const credentialsSection = document.getElementById('credentials-section');
  const credentialsList = document.getElementById('credentials-list');
  const pendingSection = document.getElementById('pending-section');
  const downloadBtn = document.getElementById('download-btn');
  const copyAllBtn = document.getElementById('copy-all-btn');

  let currentOrderId = '';
  let currentPin = '';
  let currentCredentials: any[] = [];

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl?.classList.add('hidden');
    resultsEl?.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Mencari...';

    const formData = new FormData(form);
    currentOrderId = formData.get('order_id') as string;
    currentPin = formData.get('pin') as string;

    try {
      const params = new URLSearchParams({ order_id: currentOrderId, pin: currentPin });
      const res = await fetch(`${(window as any).__API_URL__}/api/v1/orders/lookup?${params}`);
      const data = await res.json();

      if (!res.ok) {
        if (res.status === 429) {
          const retrySec = data.retry_after_seconds || 1800;
          const mins = Math.ceil(retrySec / 60);
          if (errorText) errorText.textContent = `🚫 Terlalu banyak percobaan salah (Maks 10x). Silakan coba lagi dalam ${mins} menit.`;
        } else {
          if (errorText) errorText.textContent = data.error || 'Nomor Pesanan atau PIN yang kamu masukkan salah';
        }
        errorEl?.classList.remove('hidden');
      } else {
        displayResults(data);
      }
    } catch {
      if (errorText) errorText.textContent = 'Koneksi gagal. Periksa jaringan Anda.';
      errorEl?.classList.remove('hidden');
    }

    btn.disabled = false;
    btn.textContent = 'Cari Pesanan';
  });

  function displayResults(data: any) {
    const order = data.order;

    // Order info
    const orderNumEl = document.getElementById('result-order-number');
    const productNameEl = document.getElementById('result-product-name');
    const quantityEl = document.getElementById('result-quantity');
    const totalEl = document.getElementById('result-total');
    const dateEl = document.getElementById('result-date');
    const statusBadge = document.getElementById('status-badge');

    if (orderNumEl) orderNumEl.textContent = order.order_number;
    if (productNameEl) productNameEl.textContent = order.product_title || order.product_name || order.product_slug || 'Akun Digital Premium';
    if (quantityEl) quantityEl.textContent = `${order.quantity || 1} Akun`;
    if (totalEl) totalEl.textContent = `Rp ${parseInt(order.total_amount).toLocaleString('id-ID')}`;
    if (dateEl) dateEl.textContent = new Date(order.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

    // Status badge
    if (statusBadge) {
      const statusMap: Record<string, { text: string; class: string }> = {
        PAID: { text: '✅ Sukses', class: 'bg-emerald-500/20 text-emerald-400' },
        PENDING: { text: '⏳ Menunggu', class: 'bg-amber-500/20 text-amber-400' },
        EXPIRED: { text: '⏰ Kedaluwarsa', class: 'bg-surface-700 text-surface-400' },
        FAILED: { text: '❌ Gagal', class: 'bg-red-500/20 text-red-400' },
      };
      const s = statusMap[order.status] || { text: order.status, class: 'bg-surface-700 text-surface-400' };
      statusBadge.textContent = s.text;
      statusBadge.className = `px-3 py-1 rounded-full text-xs font-semibold ${s.class}`;
    }

    // Credentials
    credentialsSection?.classList.add('hidden');
    pendingSection?.classList.add('hidden');

    if (order.status === 'PAID' && data.credentials) {
      currentCredentials = data.credentials;
      credentialsSection?.classList.remove('hidden');
      if (credentialsList) {
        credentialsList.innerHTML = '';
        data.credentials.forEach((cred: any, i: number) => {
          const card = document.createElement('div');
          card.className = 'p-4 rounded-xl bg-[#ffffff]/90 border border-[#e5d4c5] shadow-sm space-y-3';
          card.innerHTML = `
            <div class="text-xs font-bold text-[#87533d] uppercase tracking-wider">Akun #${i + 1}</div>
            <div class="space-y-2">
              <div class="p-3 rounded-lg bg-[#faf0e6] border border-[#e5d4c5]">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-bold text-[#5c4a3b] uppercase tracking-wider">WEBSITE</span>
                  <button class="copy-cred p-1 rounded hover:bg-[#e4cdb7] transition-colors" data-value="${cred.email}" aria-label="Copy email">
                    <svg class="w-3.5 h-3.5 text-[#5c4a3b] hover:text-[#1c1510]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" /></svg>
                  </button>
                </div>
                <div class="font-mono text-sm font-bold text-[#1c1510]">${cred.email}</div>
              </div>
              <div class="p-3 rounded-lg bg-[#faf0e6] border border-[#e5d4c5]">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-bold text-[#5c4a3b] uppercase tracking-wider">PASSWORD</span>
                  <div class="flex items-center gap-1">
                    <button class="toggle-pw p-1 rounded hover:bg-[#e4cdb7] transition-colors" data-value="${cred.password}" data-masked="${'•'.repeat(Math.min(cred.password.length, 12))}" aria-label="Toggle password">
                      <svg class="eye-o w-3.5 h-3.5 text-[#5c4a3b] hover:text-[#1c1510]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                      <svg class="eye-c w-3.5 h-3.5 text-[#5c4a3b] hover:text-[#1c1510] hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                    </button>
                    <button class="copy-cred p-1 rounded hover:bg-[#e4cdb7] transition-colors" data-value="${cred.password}" aria-label="Copy password">
                      <svg class="w-3.5 h-3.5 text-[#5c4a3b] hover:text-[#1c1510]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" /></svg>
                    </button>
                  </div>
                </div>
                <div class="font-mono text-sm font-bold text-[#1c1510] pw-display">${'•'.repeat(Math.min(cred.password.length, 12))}</div>
              </div>
            </div>
          `;
          credentialsList.appendChild(card);
        });

        // Bind copy buttons
        document.querySelectorAll('.copy-cred').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const val = (btn as HTMLElement).dataset.value || '';
            try {
              await navigator.clipboard.writeText(val);
              const icon = btn.querySelector('svg');
              if (icon) { icon.style.color = '#34d399'; setTimeout(() => icon.style.color = '', 1500); }
            } catch {}
          });
        });

        // Bind toggle buttons
        document.querySelectorAll('.toggle-pw').forEach((btn) => {
          btn.addEventListener('click', () => {
            const card = btn.closest('.p-3');
            const display = card?.querySelector('.pw-display');
            const eyeO = btn.querySelector('.eye-o');
            const eyeC = btn.querySelector('.eye-c');
            if (!display || !eyeO || !eyeC) return;
            const showing = !eyeO.classList.contains('hidden');
            if (showing) {
              display.textContent = (btn as HTMLElement).dataset.value || '';
              eyeO.classList.add('hidden'); eyeC.classList.remove('hidden');
            } else {
              display.textContent = (btn as HTMLElement).dataset.masked || '';
              eyeO.classList.remove('hidden'); eyeC.classList.add('hidden');
            }
          });
        });
      }
    } else if (order.status === 'PENDING') {
      pendingSection?.classList.remove('hidden');
    }

    resultsEl?.classList.remove('hidden');
  }

  // Copy All Credentials
  copyAllBtn?.addEventListener('click', async () => {
    if (!currentCredentials || currentCredentials.length === 0) return;
    const textToCopy = currentCredentials.map((c, i) => `Akun #${i + 1}\nEmail/ID: ${c.email}\nPassword: ${c.password}`).join('\n\n');
    try {
      await navigator.clipboard.writeText(textToCopy);
      const span = copyAllBtn.querySelector('span');
      if (span) {
        span.textContent = 'Tersalin! ✅';
        setTimeout(() => { span.textContent = 'Salin Semua Akun'; }, 2000);
      }
    } catch {}
  });

  // Download .txt
  downloadBtn?.addEventListener('click', () => {
    if (!currentOrderId || !currentPin) return;
    const params = new URLSearchParams({ order_id: currentOrderId, pin: currentPin });
    window.location.href = `${(window as any).__API_URL__}/api/v1/orders/download?${params}`;
  });
</script>
