---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const { slug } = Astro.params;
const API_URL = import.meta.env.PUBLIC_API_URL || '';

const defaultProducts: Record<string, any> = {
  'capcut-premium-7-days': {
    title: 'Capcut Premium (7 Hari)',
    slug: 'capcut-premium-7-days',
    description: 'Akun Capcut Premium 7 Hari privat, akses penuh semua fitur efek & template pro.',
    price_idr: 1000,
    image_url: '/images/capcut.webp',
    stock_count: 5,
  },
  'claude-ai-pro-1-bulan': {
    title: 'Claude AI Pro (1 Bulan)',
    slug: 'claude-ai-pro-1-bulan',
    description: 'Akun Claude AI Pro 1 Bulan.',
    price_idr: 55000,
    image_url: '',
    stock_count: 0,
  },
  'canva-pro-lifetime-1-tahun': {
    title: 'Canva Pro Lifetime / 1 Tahun',
    slug: 'canva-pro-lifetime-1-tahun',
    description: 'Akun Canva Pro.',
    price_idr: 25000,
    image_url: '',
    stock_count: 0,
  },
  'youtube-premium-1-bulan': {
    title: 'YouTube Premium (1 Bulan)',
    slug: 'youtube-premium-1-bulan',
    description: 'Akun YouTube Premium.',
    price_idr: 15000,
    image_url: '',
    stock_count: 0,
  },
  'spotify-premium-individual-1-bulan': {
    title: 'Spotify Premium Individual (1 Bulan)',
    slug: 'spotify-premium-individual-1-bulan',
    description: 'Akun Spotify Premium.',
    price_idr: 18000,
    image_url: '',
    stock_count: 0,
  },
  'netflix-premium-4k-uhd-1-bulan': {
    title: 'Netflix Premium 4K UHD (1 Bulan)',
    slug: 'netflix-premium-4k-uhd-1-bulan',
    description: 'Akun Netflix Premium 4K.',
    price_idr: 35000,
    image_url: '',
    stock_count: 0,
  },
  'chatgpt-plus-1-bulan': {
    title: 'ChatGPT Plus (1 Bulan)',
    slug: 'chatgpt-plus-1-bulan',
    description: 'Akun ChatGPT Plus.',
    price_idr: 45000,
    image_url: '',
    stock_count: 0,
  },
};

let product: any = null;
let notFound = false;

try {
  const res = await fetch(`${API_URL}/api/v1/products/${slug}`);
  if (res.ok) {
    product = await res.json();
  } else {
    product = defaultProducts[slug || ''] || null;
    if (!product) notFound = true;
  }
} catch {
  product = defaultProducts[slug || ''] || null;
  if (!product) notFound = true;
}

const priceFormatted = product ? new Intl.NumberFormat('id-ID', {
  style: 'currency',
  currency: 'IDR',
  minimumFractionDigits: 0,
}).format(product.price_idr) : '';

const isInStock = product?.stock_count > 0;

// For SSG, we need to define all possible slugs
export async function getStaticPaths() {
  const defaultSlugs = [
    'capcut-premium-7-days',
    'claude-ai-pro-1-bulan',
    'canva-pro-lifetime-1-tahun',
    'youtube-premium-1-bulan',
    'spotify-premium-individual-1-bulan',
    'netflix-premium-4k-uhd-1-bulan',
    'chatgpt-plus-1-bulan',
  ];

  const API_URL = import.meta.env.PUBLIC_API_URL || '';
  try {
    const res = await fetch(`${API_URL}/api/v1/products`);
    if (res.ok) {
      const data = await res.json();
      if (data.products && data.products.length > 0) {
        const fetchedSlugs = data.products.map((p: any) => p.slug);
        const allSlugs = Array.from(new Set([...defaultSlugs, ...fetchedSlugs]));
        return allSlugs.map((slug) => ({ params: { slug } }));
      }
    }
  } catch {}
  return defaultSlugs.map((slug) => ({ params: { slug } }));
}
---

<BaseLayout title={product?.title || 'Produk'} description={product?.description || ''}>
  <Header slot="header" />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    {notFound ? (
      <div class="text-center py-20">
        <h1 class="text-2xl font-bold text-white mb-4">Produk tidak ditemukan</h1>
        <p class="text-surface-400 mb-6">Produk yang kamu cari tidak tersedia atau sudah dihapus.</p>
        <a href="/" class="px-6 py-2.5 rounded-lg bg-brand-600 text-white text-sm font-medium hover:bg-brand-500 transition-colors">
          Kembali ke Beranda
        </a>
      </div>
    ) : (
      <div class="animate-fade-in">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-[#5c4a3b] mb-8 font-medium">
          <a href="/" class="hover:text-[#1c1510] transition-colors">Beranda</a>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
          <span class="text-[#1c1510] font-bold">{product.title}</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
          <!-- Product Info (3 cols) -->
          <div class="lg:col-span-3">
            <!-- Image -->
            <div class="relative h-64 sm:h-80 rounded-xl bg-gradient-to-br from-[#f5e8dd] to-[#ebd8c8] border border-[#e5d4c5] overflow-hidden mb-6">
              {product.image_url ? (
                <img src={product.image_url} alt={product.title} class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <div class="w-64 h-24 rounded-2xl bg-[#e5cbba]/50 border border-[#b8856c]/20 flex items-center justify-center">
                    <svg class="w-12 h-12 text-[#87533d]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                    </svg>
                  </div>
                </div>
              )}
            </div>

            <!-- Description -->
            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#87533d] dark:text-[#ffffff] mb-4">{product.title}</h1>
            {product.description && (
              <div class="prose prose-sm max-w-none">
                <p class="text-[#4a3b30] dark:text-[#f5eae1] leading-relaxed whitespace-pre-line font-medium">{product.description}</p>
              </div>
            )}

            <!-- Trust badges -->
            <div class="flex flex-wrap gap-3 mt-6">
              {[
                { icon: '⚡', text: 'Pengiriman instan' },
                { icon: '🔒', text: 'Pembayaran aman' },
                { icon: '✅', text: 'Akun siap pakai' },
              ].map((badge) => (
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#ffffff] dark:bg-[#2b1f17] border border-[#e5d4c5] dark:border-[#3d2d22] text-xs font-extrabold text-[#3d3025] dark:text-[#f5eae1] shadow-sm">
                  <span>{badge.icon}</span>{badge.text}
                </span>
              ))}
            </div>
          </div>

          <!-- Purchase Card (2 cols) -->
          <div class="lg:col-span-2">
            <div class="sticky top-24 p-6 rounded-xl bg-[#ffffff]/95 dark:bg-[#1c1510] border border-[#e5d4c5] dark:border-[#3d2d22] shadow-md shadow-[#3d3025]/5">
              <!-- Price -->
              <div class="mb-5">
                <span class="text-xs text-[#6f5643] dark:text-[#b8856c] uppercase font-bold tracking-wider">Harga per akun</span>
                <div class="text-3xl font-black text-[#1c1510] dark:text-[#faf0e6] mt-1">{priceFormatted}</div>
              </div>

              <!-- Stock -->
              <div id="stock-container" class="flex items-center gap-2 mb-6 p-3 rounded-lg bg-[#faf0e6] dark:bg-[#2b1f17] border border-[#e5d4c5] dark:border-[#3d2d22]">
                <span id="stock-dot" class={`w-2.5 h-2.5 rounded-full ${isInStock ? 'bg-emerald-600 animate-pulse-soft' : 'bg-rose-600'}`}></span>
                <span id="stock-text" class={`text-sm font-bold ${isInStock ? 'text-emerald-800 dark:text-emerald-400' : 'text-rose-800 dark:text-rose-400'}`}>
                  {isInStock ? `${product.stock_count} akun tersedia` : 'Stok habis'}
                </span>
              </div>

              <!-- Checkout Form Section -->
              <div id="checkout-section" class={isInStock ? '' : 'hidden'}>
                <form id="checkout-form" class="space-y-4" data-unit-price={product.price_idr} data-max-stock={product.stock_count}>
                  <input type="hidden" name="product_slug" value={product.slug} />
                  
                  <!-- Nama Pembeli -->
                  <div>
                    <label for="customer_name" class="block text-xs font-black text-[#2b1f17] dark:text-[#faf0e6] mb-1.5">
                      Nama Pembeli <span class="text-rose-500">*</span>
                    </label>
                    <input
                      type="text"
                      id="customer_name"
                      name="customer_name"
                      required
                      placeholder="Contoh: Budi Santoso"
                      class="w-full px-3.5 py-2.5 rounded-lg bg-[#faf0e6] dark:bg-[#2b1f17] border border-[#e5d4c5] dark:border-[#3d2d22] text-sm text-[#4d3a2c] dark:text-[#faf0e6] placeholder:text-[#9e644c]/70 dark:placeholder:text-[#b8856c]/60 focus:outline-none focus:border-[#87533d] focus:ring-1 focus:ring-[#87533d]/30 transition-all font-bold"
                    />
                  </div>
                  
                  <!-- Quantity Selector -->
                  <div>
                    <label for="quantity" class="block text-xs font-black text-[#2b1f17] dark:text-[#faf0e6] mb-1.5">
                      Jumlah Pembelian (Maks <span id="qty-max-count">{product.stock_count}</span> Pcs)
                    </label>
                    <div class="flex items-center gap-2">
                      <button
                        type="button"
                        id="qty-minus"
                        class="w-10 h-10 rounded-lg bg-[#faf0e6] dark:bg-[#2b1f17] border border-[#e5d4c5] dark:border-[#3d2d22] text-[#4d3a2c] dark:text-[#faf0e6] font-bold text-lg hover:bg-[#e4cdb7] dark:hover:bg-[#38291f] transition-all flex items-center justify-center select-none"
                      >
                        -
                      </button>
                      <input
                        type="number"
                        id="quantity"
                        name="quantity"
                        value="1"
                        min="1"
                        max={product.stock_count}
                        readonly
                        class="w-16 h-10 text-center rounded-lg bg-[#faf0e6] dark:bg-[#2b1f17] border border-[#e5d4c5] dark:border-[#3d2d22] text-sm text-[#4d3a2c] dark:text-[#faf0e6] font-extrabold focus:outline-none select-none"
                      />
                      <button
                        type="button"
                        id="qty-plus"
                        class="w-10 h-10 rounded-lg bg-[#faf0e6] dark:bg-[#2b1f17] border border-[#e5d4c5] dark:border-[#3d2d22] text-[#4d3a2c] dark:text-[#faf0e6] font-bold text-lg hover:bg-[#e4cdb7] dark:hover:bg-[#38291f] transition-all flex items-center justify-center select-none"
                      >
                        +
                      </button>
                      <span class="text-xs text-[#87533d] dark:text-[#b8856c] font-bold ml-2">Pcs</span>
                    </div>
                  </div>

                  <div>
                    <label for="pin" class="block text-xs font-black text-[#2b1f17] dark:text-[#faf0e6] mb-1.5">
                      PIN Keamanan <span class="text-rose-500">*</span>
                    </label>
                    <input
                      type="text"
                      id="pin"
                      name="pin"
                      required
                      maxlength="6"
                      pattern="[0-9]{6}"
                      inputmode="numeric"
                      autocomplete="off"
                      style="-webkit-text-security: disc;"
                      placeholder="Contoh: 123456"
                      class="w-full px-3.5 py-2.5 rounded-lg bg-[#faf0e6] dark:bg-[#2b1f17] border border-[#e5d4c5] dark:border-[#3d2d22] text-sm text-[#4d3a2c] dark:text-[#faf0e6] placeholder:text-[#9e644c]/70 dark:placeholder:text-[#b8856c]/60 focus:outline-none focus:border-[#87533d] focus:ring-1 focus:ring-[#87533d]/30 transition-all font-bold tracking-widest"
                    />
                  </div>

                  <div>
                    <label for="confirm_pin" class="block text-xs font-black text-[#2b1f17] dark:text-[#faf0e6] mb-1.5">
                      Konfirmasi PIN Keamanan <span class="text-rose-500">*</span>
                    </label>
                    <input
                      type="text"
                      id="confirm_pin"
                      name="confirm_pin"
                      required
                      maxlength="6"
                      pattern="[0-9]{6}"
                      inputmode="numeric"
                      autocomplete="off"
                      style="-webkit-text-security: disc;"
                      placeholder="Masukkan ulang PIN"
                      class="w-full px-3.5 py-2.5 rounded-lg bg-[#faf0e6] dark:bg-[#2b1f17] border border-[#e5d4c5] dark:border-[#3d2d22] text-sm text-[#4d3a2c] dark:text-[#faf0e6] placeholder:text-[#9e644c]/70 dark:placeholder:text-[#b8856c]/60 focus:outline-none focus:border-[#87533d] focus:ring-1 focus:ring-[#87533d]/30 transition-all font-bold tracking-widest"
                    />
                    <p class="text-[11px] text-[#87533d] dark:text-[#b8856c] font-semibold mt-1">*Buat PIN 6 angka untuk melacak & mengambil pesanan kamu.</p>
                  </div>

                  <button
                    type="submit"
                    id="checkout-btn"
                    class="btn-solid w-full py-3 rounded-xl bg-gradient-to-r from-[#87533d] to-[#b8856c] !text-[#faf0e6] font-extrabold text-sm hover:from-[#6f4332] hover:to-[#a36d54] shadow-lg shadow-[#87533d]/20 transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
                  >
                    Beli Sekarang — <span id="btn-price-display">{priceFormatted}</span>
                  </button>
                </form>

                <div id="checkout-error" class="hidden mt-4 p-3 rounded-lg bg-rose-50 dark:bg-rose-950/80 border border-rose-200 dark:border-rose-800">
                  <p class="text-xs text-rose-700 dark:text-rose-300 font-bold" id="checkout-error-text"></p>
                </div>
              </div>

              <!-- Payment info -->
              <div class="mt-6 pt-5 border-t border-[#e5d4c5] dark:border-[#3d2d22]">
                <p class="text-xs text-[#87533d] dark:text-[#b8856c] text-center font-bold">
                  *Penting : simpan Nomor Pesanan & PIN agar pesanan bisa dilacak melalui website*
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const btn = document.getElementById('checkout-btn') as HTMLButtonElement;
  const errorEl = document.getElementById('checkout-error');
  const errorText = document.getElementById('checkout-error-text');

  // Quantity controls
  const qtyInput = document.getElementById('quantity') as HTMLInputElement;
  const qtyMinus = document.getElementById('qty-minus');
  const qtyPlus = document.getElementById('qty-plus');
  const priceDisplay = document.getElementById('btn-price-display');

  function updatePrice() {
    if (!qtyInput) return;
    const currentPrice = parseFloat(form?.dataset.unitPrice || '0');
    const qty = parseInt(qtyInput.value, 10) || 1;
    const totalPrice = currentPrice * qty;
    const formatted = new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      minimumFractionDigits: 0,
    }).format(totalPrice);
    if (priceDisplay) priceDisplay.textContent = formatted;
  }

  qtyMinus?.addEventListener('click', () => {
    if (!qtyInput) return;
    let current = parseInt(qtyInput.value, 10) || 1;
    if (current > 1) {
      qtyInput.value = (current - 1).toString();
      updatePrice();
    }
  });

  qtyPlus?.addEventListener('click', () => {
    if (!qtyInput) return;
    let current = parseInt(qtyInput.value, 10) || 1;
    const currentMaxStock = parseInt(form?.dataset.maxStock || '1', 10);
    if (current < currentMaxStock) {
      qtyInput.value = (current + 1).toString();
      updatePrice();
    }
  });

  qtyInput?.addEventListener('change', () => {
    let current = parseInt(qtyInput.value, 10) || 1;
    const currentMaxStock = parseInt(form?.dataset.maxStock || '1', 10);
    if (current > currentMaxStock) {
      qtyInput.value = currentMaxStock.toString();
    } else if (current < 1) {
      qtyInput.value = '1';
    }
    updatePrice();
  });

  // Load live product data on client
  async function loadLiveProductData() {
    const productSlug = (document.querySelector('input[name="product_slug"]') as HTMLInputElement)?.value;
    if (!productSlug) return;

    try {
      const res = await fetch(`${(window as any).__API_URL__}/api/v1/products/${productSlug}`);
      if (!res.ok) return;
      const liveProduct = await res.json();
      
      if (liveProduct && typeof liveProduct.stock_count === 'number') {
        const stock = liveProduct.stock_count;
        const isInStock = stock > 0;

        if (liveProduct.price_idr && form) {
          form.dataset.unitPrice = liveProduct.price_idr.toString();
          
          const liveFormatted = new Intl.NumberFormat('id-ID', {
            style: 'currency',
            currency: 'IDR',
            minimumFractionDigits: 0,
          }).format(liveProduct.price_idr);
          
          const priceMain = document.querySelector('.lg\\:col-span-2 .text-3xl');
          if (priceMain) priceMain.textContent = liveFormatted;
        }

        // Update Stock Text and Dot dynamically from DB
        const stockDot = document.getElementById('stock-dot');
        const stockText = document.getElementById('stock-text');
        if (stockText) {
          stockText.textContent = isInStock ? `${stock} akun tersedia` : 'Stok habis';
          stockText.className = `text-sm font-bold ${isInStock ? 'text-emerald-800 dark:text-emerald-400' : 'text-rose-800 dark:text-rose-400'}`;
        }
        if (stockDot) {
          stockDot.className = `w-2.5 h-2.5 rounded-full ${isInStock ? 'bg-emerald-600 animate-pulse-soft' : 'bg-rose-600'}`;
        }

        // Toggle checkout section visibility dynamically
        const checkoutSection = document.getElementById('checkout-section');
        if (checkoutSection) {
          if (isInStock) {
            checkoutSection.classList.remove('hidden');
          } else {
            checkoutSection.classList.add('hidden');
          }
        }

        // Update max stock for quantity selector
        if (form) {
          form.dataset.maxStock = stock.toString();
          const qtyMaxCount = document.getElementById('qty-max-count');
          if (qtyMaxCount) {
            qtyMaxCount.textContent = stock.toString();
          }
          if (qtyInput) {
            qtyInput.max = stock.toString();
            const currentQty = parseInt(qtyInput.value, 10) || 1;
            if (currentQty > stock && stock > 0) {
              qtyInput.value = stock.toString();
            }
          }
        }

        updatePrice();
      }
    } catch {}
  }

  document.addEventListener('DOMContentLoaded', loadLiveProductData);
  window.addEventListener('focus', loadLiveProductData);
  loadLiveProductData();
  setInterval(loadLiveProductData, 10000);

  // Rate Limiting untuk Konfirmasi PIN Salah (10x per 30 menit)
  const MAX_MISMATCH = 10;
  const WINDOW_MS = 30 * 60 * 1000; // 30 menit

  function getPinMismatchAttempts(): { count: number; firstAttemptTime: number } {
    try {
      const data = localStorage.getItem('pin_mismatch_attempts');
      if (data) return JSON.parse(data);
    } catch {}
    return { count: 0, firstAttemptTime: 0 };
  }

  function recordPinMismatch(): { blocked: boolean; remainingMins: number } {
    const now = Date.now();
    let state = getPinMismatchAttempts();

    // Reset jika window 30 menit sudah lewat
    if (now - state.firstAttemptTime > WINDOW_MS) {
      state = { count: 1, firstAttemptTime: now };
    } else {
      state.count += 1;
    }

    try {
      localStorage.setItem('pin_mismatch_attempts', JSON.stringify(state));
    } catch {}

    if (state.count >= MAX_MISMATCH) {
      const remainingMs = WINDOW_MS - (now - state.firstAttemptTime);
      const remainingMins = Math.ceil(remainingMs / (60 * 1000));
      return { blocked: true, remainingMins };
    }

    return { blocked: false, remainingMins: 0 };
  }

  function isPinMismatchBlocked(): { blocked: boolean; remainingMins: number } {
    const now = Date.now();
    const state = getPinMismatchAttempts();

    if (state.count >= MAX_MISMATCH && (now - state.firstAttemptTime < WINDOW_MS)) {
      const remainingMs = WINDOW_MS - (now - state.firstAttemptTime);
      const remainingMins = Math.ceil(remainingMs / (60 * 1000));
      return { blocked: true, remainingMins };
    }
    return { blocked: false, remainingMins: 0 };
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errorEl) errorEl.classList.add('hidden');

    // Cek apakah user sedang diblokir karena >10x PIN tidak cocok
    const blockCheck = isPinMismatchBlocked();
    if (blockCheck.blocked) {
      if (errorText) errorText.textContent = `🚫 Terlalu banyak percobaan PIN salah (Maks 10x). Silakan coba lagi dalam ${blockCheck.remainingMins} menit.`;
      if (errorEl) errorEl.classList.remove('hidden');
      return;
    }

    const formData = new FormData(form);
    const customerName = ((formData.get('customer_name') as string) || '').trim();
    const pin = (formData.get('pin') as string) || '';
    const confirmPin = (formData.get('confirm_pin') as string) || '';
    const qty = parseInt((formData.get('quantity') as string) || '1', 10);

    if (!customerName) {
      if (errorText) errorText.textContent = '❌ Nama pembeli wajib diisi.';
      if (errorEl) errorEl.classList.remove('hidden');
      return;
    }

    const currentMaxStock = parseInt(form?.dataset.maxStock || '1', 10);
    if (qty > currentMaxStock) {
      if (errorText) errorText.textContent = `❌ Jumlah pembelian (${qty} Pcs) melebihi stok yang tersedia (Maks ${currentMaxStock} Pcs).`;
      if (errorEl) errorEl.classList.remove('hidden');
      return;
    }

    if (!pin) {
      if (errorText) errorText.textContent = '❌ PIN Keamanan wajib diisi.';
      if (errorEl) errorEl.classList.remove('hidden');
      return;
    }

    if (!confirmPin) {
      if (errorText) errorText.textContent = '❌ Konfirmasi PIN Keamanan wajib diisi.';
      if (errorEl) errorEl.classList.remove('hidden');
      return;
    }

    if (pin.length !== 6 || !/^\d{6}$/.test(pin)) {
      if (errorText) errorText.textContent = '❌ PIN Keamanan harus berupa 6 angka.';
      if (errorEl) errorEl.classList.remove('hidden');
      return;
    }

    if (pin !== confirmPin) {
      const result = recordPinMismatch();
      if (result.blocked) {
        if (errorText) errorText.textContent = `🚫 Terlalu banyak percobaan PIN salah (Maks 10x). Silakan coba lagi dalam ${result.remainingMins} menit.`;
      } else {
        if (errorText) errorText.textContent = `❌ Konfirmasi PIN tidak cocok. Silakan periksa kembali. (Percobaan ke-${getPinMismatchAttempts().count} dari 10)`;
      }
      if (errorEl) errorEl.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Memproses...';

    const body = {
      product_slug: formData.get('product_slug'),
      customer_name: customerName,
      pin: pin,
      quantity: qty,
    };

    try {
      const res = await fetch(`${(window as any).__API_URL__}/api/v1/checkout`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      const data = await res.json();

      if (res.ok && data.payment_url) {
        // Redirect to Duitku payment page
        window.location.href = data.payment_url;
      } else {
        if (res.status === 429) {
          const retrySec = data.retry_after_seconds || 1800;
          const mins = Math.ceil(retrySec / 60);
          if (errorText) errorText.textContent = `🚫 Terlalu banyak transaksi (Maks 10x). Silakan coba lagi dalam ${mins} menit.`;
        } else {
          if (errorText) errorText.textContent = data.error || 'Checkout gagal. Silakan coba lagi.';
        }
        errorEl?.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = `Beli Sekarang`;
      }
    } catch {
      if (errorText) errorText.textContent = 'Koneksi gagal. Periksa jaringan Anda.';
      errorEl?.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = `Beli Sekarang`;
    }
  });
</script>
