---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';

// In production, this would fetch from the API at build time or SSR
// For now, we'll use client-side fetching for dynamic stock counts
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';

let products: any[] = [];
let fetchError = false;

try {
  const res = await fetch(`${API_URL}/api/v1/products`);
  if (res.ok) {
    const data = await res.json();
    products = data.products || [];
  }
} catch {
  fetchError = true;
}
---

<BaseLayout title="Lexaa Store" description="Toko akun digital premium — Beli akun instan dengan harga terjangkau. Pengiriman otomatis, pembayaran aman & mudah.">
  <Header slot="header" />

  <!-- Hero Section -->
  <section class="relative pt-20 pb-16 sm:pt-28 sm:pb-24 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
      <!-- Main heading -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight mb-6 animate-slide-up">
        <span class="text-[#4d3a2c] dark:text-[#f5eae1]">Akun Digital</span>
        <br />
        <span class="text-[#a86e56] dark:text-[#fceddf]">Premium & Instan</span>
      </h1>

      <p class="max-w-2xl mx-auto text-base sm:text-lg text-[#4d3a2c] dark:text-[#c4b1a2] font-bold leading-relaxed mb-10 animate-slide-up" style="animation-delay: 100ms">
        Beli akun digital berkualitas dengan proses otomatis. Bayar, terima detail akun di website, selesai dalam hitungan menit.
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up" style="animation-delay: 200ms">
        <a href="#produk" class="btn-solid w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[#4d3a2c] dark:bg-gradient-to-r dark:from-[#87533d] dark:to-[#b8856c] !text-[#faf0e6] font-extrabold text-sm hover:bg-[#38281d] dark:hover:from-[#6f4332] dark:hover:to-[#a36d54] shadow-lg shadow-[#4d3a2c]/20 transition-all duration-300" id="cta-browse">
          Lihat Produk
        </a>
        <a href="/lacak" class="btn-solid w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[#4d3a2c] dark:bg-[#2b1f17] border border-[#4d3a2c] dark:border-[#3d2d22] !text-[#faf0e6] font-extrabold text-sm hover:bg-[#38281d] dark:hover:bg-[#38291f] transition-all duration-300 shadow-md" id="cta-track">
          Lacak Pesanan
        </a>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-6 max-w-lg mx-auto mt-16 animate-slide-up" style="animation-delay: 300ms">
        <div class="text-center">
          <div class="text-2xl sm:text-3xl font-black text-[#4d3a2c] dark:text-[#f5eae1]">100%</div>
          <div class="text-xs sm:text-sm text-[#4d3a2c] dark:text-[#a89586] font-bold mt-1">Otomatis</div>
        </div>
        <div class="text-center border-x border-[#4d3a2c]/20 dark:border-[#3d2d22]">
          <div class="text-2xl sm:text-3xl font-black text-[#4d3a2c] dark:text-[#f5eae1]">Terbatas</div>
          <div class="text-xs sm:text-sm text-[#4d3a2c] dark:text-[#a89586] font-bold mt-1">Stok Akun</div>
        </div>
        <div class="text-center">
          <div class="text-2xl sm:text-3xl font-black text-[#4d3a2c] dark:text-[#f5eae1]">Instan</div>
          <div class="text-xs sm:text-sm text-[#4d3a2c] dark:text-[#a89586] font-bold mt-1">Pengiriman</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Products Section -->
  <section id="produk" class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-[#1c1510] dark:text-[#f5eae1] mb-3">Pilih Produk</h2>
        <p class="text-[#5c4a3b] dark:text-[#c4b1a2] text-sm">Semua akun sudah siap digunakan</p>
      </div>

      <div id="product-container">
        {fetchError ? (
          <div class="fetch-error-msg text-center py-16">
            <div class="w-16 h-16 rounded-2xl bg-[#f3e3d3] dark:bg-[#2b1f17] flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#8c735d]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
              </svg>
            </div>
            <p class="text-[#5c4a3b] dark:text-[#c4b1a2]">Memuat produk...</p>
          </div>
        ) : products.length === 0 ? (
          <div class="no-products-msg text-center py-16">
            <div class="w-16 h-16 rounded-2xl bg-[#f3e3d3] dark:bg-[#2b1f17] flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#8c735d]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
              </svg>
            </div>
            <p class="text-[#5c4a3b] dark:text-[#c4b1a2]">Belum ada produk tersedia saat ini.</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {products.map((product: any, i: number) => (
              <ProductCard
                title={product.title}
                slug={product.slug}
                price={product.price_idr}
                stockCount={product.stock_count}
                imageUrl={product.image_url}
                index={i}
              />
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <script define:vars={{ API_URL }}>
    async function loadProductsClient() {
      const container = document.getElementById('product-container');
      if (!container) return;
      try {
        const res = await fetch(`${API_URL}/api/v1/products`);
        if (!res.ok) throw new Error('API request failed');
        const data = await res.json();
        const prods = data.products || [];
        
        if (prods.length === 0) {
          container.innerHTML = `
            <div class="no-products-msg text-center py-16">
              <div class="w-16 h-16 rounded-2xl bg-[#f3e3d3] dark:bg-[#2b1f17] flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-[#8c735d]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
                </svg>
              </div>
              <p class="text-[#5c4a3b] dark:text-[#c4b1a2]">Belum ada produk tersedia saat ini.</p>
            </div>
          `;
          return;
        }

        const cardsHtml = prods.map((p, i) => {
          const priceFormatted = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(p.price_idr);
          const isInStock = p.stock_count > 0;
          const stockLabel = isInStock ? `${p.stock_count} tersedia` : 'Stok habis';
          const stockDot = p.stock_count > 5 ? 'bg-emerald-600' : p.stock_count > 0 ? 'bg-amber-600' : 'bg-rose-600';
          const imgContent = p.image_url 
            ? `<img src="${p.image_url}" alt="${p.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />`
            : `<div class="w-full h-full flex items-center justify-center"><div class="w-44 h-16 rounded-xl bg-[#38281d] border border-[#b8856c]/20 flex items-center justify-center group-hover:scale-105 transition-transform duration-300"><svg class="w-8 h-8 text-[#e4cdb7]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg></div></div>`;

          return `
            <a href="/produk/${p.slug}" class="card-product group block rounded-xl bg-[#2b1f17] dark:bg-[#1c1510]/90 border border-[#3d2d22] dark:border-[#3d2d22] hover:border-[#b8856c]/50 hover:shadow-lg transition-all duration-300 overflow-hidden animate-fade-in" style="animation-delay: ${i * 100}ms" id="product-card-${p.slug}">
              <div class="relative h-44 bg-gradient-to-br from-[#38281d] to-[#2b1f17] dark:from-[#2b1f17] dark:to-[#1c1510] overflow-hidden">
                ${imgContent}
                <div class="absolute bottom-3 right-3 px-3 py-1.5 rounded-lg bg-[#120e0b]/90 border border-[#b8856c]/30 backdrop-blur-md text-sm font-extrabold text-[#faf0e6] shadow-sm">
                  ${priceFormatted}
                </div>
              </div>
              <div class="p-5">
                <h3 class="card-title text-base font-extrabold text-[#faf0e6] group-hover:text-[#b8856c] transition-colors mb-3 line-clamp-1">${p.title}</h3>
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full ${stockDot} ${isInStock ? 'animate-pulse-soft' : ''}"></span>
                    <span class="card-text text-xs text-[#e5d4c5] font-medium">${stockLabel}</span>
                  </div>
                  <div class="w-7 h-7 rounded-full bg-[#38281d] group-hover:bg-[#87533d] flex items-center justify-center transition-all duration-300 group-hover:translate-x-0.5">
                    <svg class="w-3.5 h-3.5 text-[#faf0e6] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                  </div>
                </div>
              </div>
            </a>
          `;
        }).join('');

        container.innerHTML = `<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">${cardsHtml}</div>`;
      } catch (err) {
        console.error('Dynamic product load failed:', err);
      }
    }

    document.addEventListener('DOMContentLoaded', loadProductsClient);
    loadProductsClient();
  </script>

  <!-- How it works -->
  <section class="py-16 border-t border-[#e5d4c5] dark:border-[#3d2d22]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-[#1c1510] dark:text-[#f5eae1] mb-3">Cara Pembelian</h2>
        <p class="text-[#5c4a3b] dark:text-[#c4b1a2] text-sm">3 langkah mudah untuk mendapatkan akun digital</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { step: '01', icon: '🛒', title: 'Pilih Produk', desc: 'Browse dan pilih akun digital yang kamu butuhkan.' },
          { step: '02', icon: '💳', title: 'Bayar', desc: 'Checkout dan bayar dengan metode pembayaran QRIS.' },
          { step: '03', icon: '💻', title: 'Terima Akun', desc: 'Detail akun langsung diakses di website dalam hitungan menit.' },
        ].map((item) => (
          <div class="step-card relative p-6 rounded-xl bg-[#2b1f17] dark:bg-[#1c1510]/90 border border-[#3d2d22] dark:border-[#3d2d22] group hover:border-[#b8856c]/50 transition-all duration-300">
            <div class="text-5xl font-black !text-[#b8856c] absolute top-4 right-5 group-hover:text-[#d9a084] transition-colors">{item.step}</div>
            <div class="text-3xl mb-4">{item.icon}</div>
            <h3 class="step-title text-base font-extrabold !text-[#faf0e6] mb-2">{item.title}</h3>
            <p class="step-desc text-sm !text-[#e5d4c5] leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
