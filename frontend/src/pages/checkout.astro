---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Detail Pembayaran — Lexaa Store" description="Instruksi pembayaran QRIS & Transfer Bank dengan kode unik.">
  <Header slot="header" />

  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-12 animate-fade-in">
    <!-- Header Title -->
    <div class="text-center mb-8">
      <div class="w-16 h-16 rounded-full bg-[#f3e3d3] text-[#87533d] flex items-center justify-center mx-auto mb-4 border border-[#e5d4c5] shadow-inner">
        <svg class="w-8 h-8 animate-pulse-soft" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-[#87533d] dark:text-[#faf0e6] mb-2">Instruksi Pembayaran</h1>
      <p class="text-xs sm:text-sm text-[#5c4a3b] dark:text-[#d3c2b4]">
        Transfer tepat sesuai nominal hingga 3 digit terakhir agar sistem otomatis memverifikasi pesanan Anda.
      </p>
    </div>

    <!-- Order Summary Card -->
    <div class="p-6 rounded-2xl bg-[#ffffff]/90 dark:bg-[#2a221b]/90 border border-[#e5d4c5] dark:border-[#4a3b30] shadow-sm mb-6 space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-[#e5d4c5]/60 dark:border-[#4a3b30]/60 text-sm">
        <span class="text-[#5c4a3b] dark:text-[#d3c2b4] font-medium">Nomor Pesanan</span>
        <div class="flex items-center gap-2">
          <span class="font-mono text-[#1c1510] dark:text-[#faf0e6] font-bold text-sm" id="order-id-val">-</span>
          <button id="copy-order-btn" class="px-2 py-1 rounded-lg bg-[#f3e3d3] hover:bg-[#e4cdb7] dark:bg-[#4a3b30] dark:hover:bg-[#5c4a3b] text-[#1c1510] dark:text-[#faf0e6] transition-all text-xs font-bold flex items-center gap-1">
            <span class="btn-lbl">Salin</span>
          </button>
        </div>
      </div>

      <!-- Nominal Highlight Box -->
      <div class="p-4 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/50 text-center">
        <div class="text-xs font-semibold text-amber-800 dark:text-amber-300 uppercase tracking-wider mb-1">Total Yang Harus Ditransfer</div>
        <div class="text-3xl sm:text-4xl font-extrabold text-amber-900 dark:text-amber-200 font-mono my-1 tracking-tight" id="total-amount-display">
          Rp -
        </div>
        <div class="text-[11px] text-amber-700 dark:text-amber-400 font-medium flex items-center justify-center gap-1 mt-1">
          <svg class="w-4 h-4 text-amber-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Termasuk Kode Unik Verifikasi Otomatis</span>
        </div>
        <button id="copy-amount-btn" class="mt-3 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-amber-700 hover:bg-amber-800 text-white font-bold text-xs transition-colors shadow-sm">
          <span>📋</span> <span id="copy-amount-lbl">Salin Nominal Tepat</span>
        </button>
      </div>

      <!-- Payment Methods Accordion / Tabs -->
      <div class="space-y-3 pt-2">
        <div class="text-xs font-bold text-[#87533d] dark:text-[#faf0e6] uppercase tracking-wider">Pilihan Metode Transfer:</div>

        <!-- Method 1: QRIS / E-Wallet -->
        <div class="p-4 rounded-xl bg-[#faf0e6] dark:bg-[#342a22] border border-[#e5d4c5] dark:border-[#4a3b30]">
          <div class="flex items-center justify-between mb-2">
            <div class="font-bold text-sm text-[#1c1510] dark:text-[#faf0e6] flex items-center gap-2">
              <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-bold">QRIS All Payment</span>
              <span>DANA / GoPay / OVO / ShopeePay / Mobile Banking</span>
            </div>
          </div>
          <p class="text-xs text-[#5c4a3b] dark:text-[#d3c2b4] leading-relaxed mb-3">
            Scan QRIS di bawah ini melalui aplikasi e-wallet / banking Anda, lalu masukkan nominal <strong class="text-amber-800 dark:text-amber-300" id="qris-amount-hint">sesuai total di atas</strong>.
          </p>
          <div class="flex flex-col items-center justify-center p-3 rounded-lg bg-white dark:bg-black/40 border border-[#e5d4c5] dark:border-[#4a3b30]">
            <!-- Dummy / QRIS SVG generator or placeholder -->
            <div class="w-44 h-44 bg-white p-2 rounded-lg border flex items-center justify-center shadow-inner">
              <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=00020101021126580014ID.LINKAJA.WWW01189360091100220260805204000000005802ID5911LEXAA%20STORE6015YOGYAKARTA6105552816304" alt="QRIS Lexaa Store" class="w-full h-full object-contain" />
            </div>
            <span class="text-[11px] text-[#5c4a3b] dark:text-[#d3c2b4] mt-2 font-medium">NPMI: LEXAA STORE QRIS</span>
          </div>
        </div>

        <!-- Method 2: Transfer Bank Manual -->
        <div class="p-4 rounded-xl bg-[#faf0e6] dark:bg-[#342a22] border border-[#e5d4c5] dark:border-[#4a3b30] space-y-2">
          <div class="font-bold text-sm text-[#1c1510] dark:text-[#faf0e6] flex items-center justify-between">
            <span>Bank BCA</span>
            <span class="text-xs font-normal text-[#5c4a3b] dark:text-[#d3c2b4]">a.n. Lexaa Store Owner</span>
          </div>
          <div class="flex items-center justify-between p-2.5 rounded-lg bg-white dark:bg-black/40 border border-[#e5d4c5] dark:border-[#4a3b30]">
            <span class="font-mono font-bold text-sm text-[#1c1510] dark:text-[#faf0e6]">1234 5678 90</span>
            <button id="copy-bank-btn" class="px-2 py-1 rounded bg-[#f3e3d3] hover:bg-[#e4cdb7] dark:bg-[#4a3b30] dark:hover:bg-[#5c4a3b] text-xs font-bold text-[#1c1510] dark:text-[#faf0e6]">
              <span id="copy-bank-lbl">Salin Rekening</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Status Banner & Polling Indicator -->
    <div class="p-4 rounded-xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/40 text-center mb-6">
      <div class="flex items-center justify-center gap-2 text-xs font-bold text-amber-800 dark:text-amber-300">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-ping"></span>
        <span id="status-text">Mengecek Pembayaran Secara Otomatis...</span>
      </div>
      <p class="text-[11px] text-amber-700 dark:text-amber-400 mt-1">
        Jangan tutup halaman ini. Begitu transfer terdeteksi oleh sistem Android Notifikasi, halaman ini akan otomatis berpindah ke kuitansi & kredensial akun digital Anda.
      </p>
    </div>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <button
        id="simulate-pay-btn"
        class="px-5 py-2.5 rounded-xl bg-emerald-700 hover:bg-emerald-600 text-white font-bold text-xs transition-colors shadow-md flex items-center justify-center gap-2"
      >
        <span>⚡</span> Simulasi Bayar (Tes Listener)
      </button>
      <a
        id="track-link"
        href="/lacak"
        class="px-5 py-2.5 rounded-xl bg-[#87533d] hover:bg-[#6f4332] text-white font-bold text-xs transition-colors shadow-md text-center"
      >
        Lacak Pesanan Ini
      </a>
      <a
        href="/"
        class="px-5 py-2.5 rounded-xl bg-[#f3e3d3] hover:bg-[#e4cdb7] dark:bg-[#342a22] dark:hover:bg-[#4a3b30] text-[#1c1510] dark:text-[#faf0e6] font-bold text-xs transition-colors border border-[#e5d4c5] dark:border-[#4a3b30] text-center"
      >
        Kembali ke Toko
      </a>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const urlParams = new URLSearchParams(window.location.search);
  const orderId = urlParams.get('order_id') || urlParams.get('id') || '';
  const pinParam = urlParams.get('pin') || '';
  let rawAmount = 0;

  const orderIdVal = document.getElementById('order-id-val');
  const trackLink = document.getElementById('track-link') as HTMLAnchorElement;
  const copyBtn = document.getElementById('copy-order-btn');
  const btnLbl = copyBtn?.querySelector('.btn-lbl');
  const totalDisplay = document.getElementById('total-amount-display');
  const qrisHint = document.getElementById('qris-amount-hint');

  if (orderIdVal) orderIdVal.textContent = orderId;
  if (trackLink) trackLink.href = `/lacak?order_id=${orderId}${pinParam ? '&pin=' + pinParam : ''}`;

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(orderId);
      if (btnLbl) {
        btnLbl.textContent = 'Tersalin! ✅';
        setTimeout(() => { btnLbl.textContent = 'Salin'; }, 2000);
      }
    } catch {}
  });

  // Fetch Order details for amount
  async function fetchOrderDetails() {
    try {
      const pinQuery = pinParam ? `&pin=${pinParam}` : '';
      const res = await fetch(`${(window as any).__API_URL__}/api/v1/orders/lookup?order_id=${orderId}${pinQuery}`, {
        method: 'GET'
      });
      if (res.ok) {
        const data = await res.json();
        if (data.order) {
          rawAmount = data.order.total_amount || 0;
          const formatted = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(rawAmount);
          if (totalDisplay) totalDisplay.textContent = formatted;
          if (qrisHint) qrisHint.textContent = `yaitu ${formatted}`;

          if (data.order.status === 'PAID') {
            window.location.href = `/lacak?order_id=${orderId}${pinParam ? '&pin=' + pinParam : ''}`;
          }
        }
      }
    } catch {}
  }

  fetchOrderDetails();

  // Copy Amount
  const copyAmountBtn = document.getElementById('copy-amount-btn');
  const copyAmountLbl = document.getElementById('copy-amount-lbl');
  copyAmountBtn?.addEventListener('click', async () => {
    if (!rawAmount) return;
    try {
      await navigator.clipboard.writeText(rawAmount.toString());
      if (copyAmountLbl) {
        copyAmountLbl.textContent = 'Tersalin! ✅';
        setTimeout(() => { copyAmountLbl.textContent = 'Salin Nominal Tepat'; }, 2000);
      }
    } catch {}
  });

  // Copy Bank
  const copyBankBtn = document.getElementById('copy-bank-btn');
  const copyBankLbl = document.getElementById('copy-bank-lbl');
  copyBankBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('1234567890');
      if (copyBankLbl) {
        copyBankLbl.textContent = 'Tersalin! ✅';
        setTimeout(() => { copyBankLbl.textContent = 'Salin Rekening'; }, 2000);
      }
    } catch {}
  });

  // Auto Polling Status every 3 seconds
  const pollInterval = setInterval(async () => {
    try {
      const pinQuery = pinParam ? `&pin=${pinParam}` : '';
      const res = await fetch(`${(window as any).__API_URL__}/api/v1/orders/lookup?order_id=${orderId}${pinQuery}`);
      if (res.ok) {
        const data = await res.json();
        if (data.order && data.order.status === 'PAID') {
          clearInterval(pollInterval);
          window.location.href = `/lacak?order_id=${orderId}${pinParam ? '&pin=' + pinParam : ''}`;
        }
      }
    } catch {}
  }, 3000);

  // Simulate Pay Button (Testing)
  const simBtn = document.getElementById('simulate-pay-btn') as HTMLButtonElement;
  simBtn?.addEventListener('click', async () => {
    simBtn.disabled = true;
    simBtn.textContent = 'Memproses Simulasi...';

    try {
      const res = await fetch(`${(window as any).__API_URL__}/api/v1/orders/simulate-pay`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ order_number: orderId }),
      });

      if (res.ok) {
        window.location.href = `/lacak?order_id=${orderId}`;
      } else {
        alert('Gagal mensimulasikan pembayaran.');
        simBtn.disabled = false;
        simBtn.textContent = '⚡ Simulasi Bayar (Tes Listener)';
      }
    } catch {
      alert('Gagal terhubung ke server.');
      simBtn.disabled = false;
      simBtn.textContent = '⚡ Simulasi Bayar (Tes Listener)';
    }
  });
</script>
