---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Detail Pesanan" description="Detail checkout dan pembayaran pesanan Anda.">
  <Header slot="header" />

  <div class="max-w-xl mx-auto px-4 sm:px-6 py-16 text-center animate-fade-in">
    <div class="w-16 h-16 rounded-full bg-[#f3e3d3] text-[#87533d] flex items-center justify-center mx-auto mb-6 border border-[#e5d4c5]">
      <svg class="w-8 h-8 animate-pulse-soft" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>

    <h1 class="text-2xl sm:text-3xl font-extrabold text-[#87533d] dark:text-[#faf0e6] mb-3">Pesanan Dibuat!</h1>
    
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#ffffff]/90 border border-[#e5d4c5] mb-6 shadow-sm">
      <span class="text-xs font-medium text-[#5c4a3b]">Order ID:</span>
      <span class="font-mono text-[#1c1510] font-bold text-sm tracking-wide" id="order-id-val">-</span>
      <button
        id="copy-order-btn"
        class="ml-1 p-1.5 rounded-lg bg-[#f3e3d3] hover:bg-[#e4cdb7] text-[#1c1510] transition-all flex items-center gap-1 text-xs font-bold"
        aria-label="Salin Order ID"
      >
        <svg class="w-3.5 h-3.5 copy-ico text-[#5c4a3b]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
        </svg>
        <span class="btn-lbl">Salin</span>
      </button>
    </div>

    <div class="p-6 rounded-xl bg-[#ffffff]/90 border border-[#e5d4c5] text-left space-y-4 mb-8 shadow-sm">
      <div class="flex items-center justify-between text-sm">
        <span class="text-[#5c4a3b] font-medium">Status Pembayaran</span>
        <span class="px-2.5 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-bold">Menunggu Pembayaran</span>
      </div>
      <p class="text-xs text-[#5c4a3b] leading-relaxed font-medium">
        Silakan selesaikan pembayaran sesuai metode yang dipilih. Setelah pembayaran berhasil, detail akun akan secara otomatis dikirimkan ke email Anda dan dapat diakses langsung dari halaman Lacak Pesanan.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <button
        id="simulate-pay-btn"
        class="px-6 py-3 rounded-xl bg-emerald-700 hover:bg-emerald-600 text-white font-bold text-sm transition-colors shadow-lg shadow-emerald-700/20 flex items-center justify-center gap-2"
      >
        <span>⚡</span> Simulasi Bayar Sukses
      </button>
      <a
        id="track-link"
        href="/lacak"
        class="px-6 py-3 rounded-xl bg-[#87533d] hover:bg-[#6f4332] text-white font-bold text-sm transition-colors shadow-lg shadow-[#87533d]/20"
      >
        Lacak Pesanan Ini
      </a>
      <a
        href="/"
        class="px-6 py-3 rounded-xl bg-[#f3e3d3] hover:bg-[#e4cdb7] text-[#1c1510] font-bold text-sm transition-colors border border-[#e5d4c5]"
      >
        Kembali ke Toko
      </a>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const urlParams = new URLSearchParams(window.location.search);
  const orderId = urlParams.get('order_id') || urlParams.get('id') || 'DS-1722792000';
  
  const orderIdVal = document.getElementById('order-id-val');
  const trackLink = document.getElementById('track-link') as HTMLAnchorElement;
  const copyBtn = document.getElementById('copy-order-btn');
  const btnLbl = copyBtn?.querySelector('.btn-lbl');

  if (orderIdVal) orderIdVal.textContent = orderId;
  if (trackLink) trackLink.href = `/lacak?order_id=${orderId}`;

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(orderId);
      if (btnLbl) {
        btnLbl.textContent = 'Tersalin! ✅';
        setTimeout(() => {
          btnLbl.textContent = 'Salin';
        }, 2000);
      }
    } catch {}
  });

  const simBtn = document.getElementById('simulate-pay-btn') as HTMLButtonElement;
  simBtn?.addEventListener('click', async () => {
    simBtn.disabled = true;
    simBtn.textContent = 'Memproses Simulasi...';

    try {
      const res = await fetch(`${(window as any).__API_URL__}/api/v1/orders/simulate-pay`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ order_number: orderId }),
      });

      if (res.ok) {
        window.location.href = `/lacak?order_id=${orderId}`;
      } else {
        alert('Gagal mensimulasikan pembayaran.');
        simBtn.disabled = false;
        simBtn.textContent = '⚡ Simulasi Bayar Sukses';
      }
    } catch {
      alert('Gagal terhubung ke server.');
      simBtn.disabled = false;
      simBtn.textContent = '⚡ Simulasi Bayar Sukses';
    }
  });
</script>
