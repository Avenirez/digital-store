---
interface Props {
  label: string;
  value: string;
  isMasked?: boolean;
}

const { label, value, isMasked = false } = Astro.props;
const maskedValue = '•'.repeat(Math.min(value.length, 12));
const uniqueId = `copy-${label.toLowerCase().replace(/\s+/g, '-')}-${Math.random().toString(36).substring(2, 8)}`;
---

<div class="p-4 rounded-lg bg-surface-800/60 border border-surface-700/50" id={uniqueId}>
  <div class="flex items-center justify-between mb-1.5">
    <span class="text-xs font-medium text-surface-400 uppercase tracking-wider">{label}</span>
    <div class="flex items-center gap-1.5">
      {isMasked && (
        <button
          class="toggle-btn p-1 rounded hover:bg-surface-700/50 transition-colors"
          data-value={value}
          data-masked={maskedValue}
          aria-label="Toggle visibility"
        >
          <svg class="eye-open w-4 h-4 text-surface-400 hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <svg class="eye-closed w-4 h-4 text-surface-400 hover:text-white hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
          </svg>
        </button>
      )}
      <button
        class="copy-btn p-1 rounded hover:bg-surface-700/50 transition-colors"
        data-copy-value={value}
        aria-label={`Copy ${label}`}
      >
        <svg class="copy-icon w-4 h-4 text-surface-400 hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
        </svg>
        <svg class="check-icon w-4 h-4 text-emerald-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
      </button>
    </div>
  </div>

  <div class="font-mono text-sm text-white select-all break-all display-value">
    {isMasked ? maskedValue : value}
  </div>
</div>

<script>
  // Toggle password visibility
  document.querySelectorAll('.toggle-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const container = btn.closest('[id^="copy-"]');
      const displayEl = container?.querySelector('.display-value');
      const eyeOpen = btn.querySelector('.eye-open');
      const eyeClosed = btn.querySelector('.eye-closed');
      
      if (!displayEl || !eyeOpen || !eyeClosed) return;

      const isCurrentlyMasked = !eyeOpen.classList.contains('hidden');
      
      if (isCurrentlyMasked) {
        displayEl.textContent = (btn as HTMLElement).dataset.value || '';
        eyeOpen.classList.add('hidden');
        eyeClosed.classList.remove('hidden');
      } else {
        displayEl.textContent = (btn as HTMLElement).dataset.masked || '';
        eyeOpen.classList.remove('hidden');
        eyeClosed.classList.add('hidden');
      }
    });
  });

  // Copy to clipboard
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = (btn as HTMLElement).dataset.copyValue || '';
      const copyIcon = btn.querySelector('.copy-icon');
      const checkIcon = btn.querySelector('.check-icon');

      try {
        await navigator.clipboard.writeText(value);
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
        }, 2000);
      } catch {
        // Fallback
        const textarea = document.createElement('textarea');
        textarea.value = value;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }
    });
  });
</script>
