---
interface Props {
  title: string;
  slug: string;
  price: number;
  stockCount: number;
  imageUrl?: string;
  index?: number;
}

const { title, slug, price, stockCount, imageUrl, index = 0 } = Astro.props;

const priceFormatted = new Intl.NumberFormat('id-ID', {
  style: 'currency',
  currency: 'IDR',
  minimumFractionDigits: 0,
}).format(price);

const isInStock = stockCount > 0;
const stockLabel = isInStock ? `${stockCount} akun tersedia` : 'Stok habis';
const stockColor = stockCount > 5 ? 'text-emerald-700 font-semibold' : stockCount > 0 ? 'text-amber-800 font-semibold' : 'text-rose-700 font-semibold';
const stockDot = stockCount > 5 ? 'bg-emerald-600' : stockCount > 0 ? 'bg-amber-600' : 'bg-rose-600';
---

<a
  href={`/produk/${slug}`}
  class="card-product group block rounded-xl bg-[#2b1f17] dark:bg-[#1c1510]/90 border border-[#3d2d22] dark:border-[#3d2d22] hover:border-[#b8856c]/50 hover:shadow-lg transition-all duration-300 overflow-hidden animate-fade-in"
  style={`animation-delay: ${index * 100}ms`}
  id={`product-card-${slug}`}
>
  <!-- Image area -->
  <div class="relative h-44 bg-gradient-to-br from-[#38281d] to-[#2b1f17] dark:from-[#2b1f17] dark:to-[#1c1510] overflow-hidden">
    {imageUrl ? (
      <img
        src={imageUrl}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <div class="w-44 h-16 rounded-xl bg-[#38281d] border border-[#b8856c]/20 flex items-center justify-center group-hover:scale-105 transition-transform duration-300">
          <svg class="w-8 h-8 text-[#e4cdb7]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
        </div>
      </div>
    )}

    <!-- Price badge -->
    <div class="absolute bottom-3 right-3 px-3 py-1.5 rounded-lg bg-[#120e0b]/90 border border-[#b8856c]/30 backdrop-blur-md text-sm font-extrabold text-[#faf0e6] shadow-sm">
      {priceFormatted}
    </div>
  </div>

  <!-- Content -->
  <div class="p-5">
    <h3 class="card-title text-base font-extrabold text-[#faf0e6] group-hover:text-[#b8856c] transition-colors mb-3 line-clamp-1">
      {title}
    </h3>

    <div class="flex items-center justify-between">
      <!-- Stock indicator -->
      <div class="flex items-center gap-2">
        <span class={`w-2 h-2 rounded-full ${stockDot} ${isInStock ? 'animate-pulse-soft' : ''}`}></span>
        <span class="card-text text-xs text-[#e5d4c5] font-medium">{stockLabel}</span>
      </div>

      <!-- Arrow -->
      <div class="w-7 h-7 rounded-full bg-[#38281d] group-hover:bg-[#87533d] flex items-center justify-center transition-all duration-300 group-hover:translate-x-0.5">
        <svg class="w-3.5 h-3.5 text-[#faf0e6] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </div>
    </div>
  </div>
</a>
