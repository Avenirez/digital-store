---
const year = new Date().getFullYear();
---

<footer class="border-t border-[#e5d4c5] mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <a href="/" class="flex items-center gap-2.5 mb-4">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-[#87533d] to-[#6f4332] dark:from-[#b8856c] dark:to-[#87533d] flex items-center justify-center">
            <svg class="w-4 h-4 text-white dark:text-[#120e0b]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="text-base font-extrabold text-[#1c1510] dark:text-[#f5eae1]">Lexaa <span class="logo-store text-[#87533d] dark:text-[#b8856c]">Store</span></span>
        </a>
        <p class="text-sm text-[#5c4a3b] leading-relaxed">
          Marketplace akun digital premium.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-extrabold text-[#87533d] dark:text-[#f5eae1] uppercase tracking-wider mb-4">Menu</h3>
        <ul class="space-y-2.5">
          <li><a href="/" class="text-sm text-[#87533d] dark:text-[#d9c5b5] hover:text-[#6f4332] dark:hover:text-white font-bold transition-colors">Beranda</a></li>
          <li><a href="/#produk" class="text-sm text-[#87533d] dark:text-[#d9c5b5] hover:text-[#6f4332] dark:hover:text-white font-bold transition-colors">Semua Produk</a></li>
          <li><a href="/lacak" class="text-sm text-[#87533d] dark:text-[#d9c5b5] hover:text-[#6f4332] dark:hover:text-white font-bold transition-colors">Lacak Pesanan</a></li>
        </ul>
      </div>

      <!-- Info -->
      <div>
        <h3 class="text-sm font-extrabold text-[#87533d] dark:text-[#f5eae1] uppercase tracking-wider mb-4">Info</h3>
        <ul class="space-y-2.5">
          <li class="footer-info-item flex items-center gap-2 text-sm text-[#87533d] dark:text-[#e5d4c5] font-extrabold">
            <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Pengiriman otomatis & instan
          </li>
          <li class="footer-info-item flex items-center gap-2 text-sm text-[#87533d] dark:text-[#e5d4c5] font-extrabold">
            <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            Pembayaran aman & terpercaya
          </li>
          <li class="footer-info-item flex items-center gap-2 text-sm text-[#87533d] dark:text-[#e5d4c5] font-extrabold">
            <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Detail akun dikirim via email
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-[#e5d4c5] mt-8 pt-8 text-center">
      <p class="text-xs text-[#8c735d]">
        &copy; {year} Lexaa Store. All rights reserved.
      </p>
    </div>
  </div>
</footer>
