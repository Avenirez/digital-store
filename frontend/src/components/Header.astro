---
const navLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/#produk', label: 'Produk' },
  { href: '/lacak', label: 'Lacak Pesanan' },
  { href: '/pesanan', label: 'Pesanan Lunas' },
];
---

<header class="sticky top-0 z-50 glass border-b border-[#e5d4c5] dark:border-[#3d2d22]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group" id="header-logo">
        <div class="w-10 h-10 rounded-full overflow-hidden flex items-center justify-center shrink-0">
          <img
            src="/logo.png"
            alt="Lexaa Store Logo"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
          />
        </div>
        <span class="text-lg font-extrabold text-[#1c1510] dark:text-[#f5eae1] tracking-tight">
          Lexaa <span class="logo-store text-[#87533d] dark:text-[#b8856c]" style="color: var(--logo-store-color);">Store</span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1" id="desktop-nav">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-4 py-2 rounded-lg text-sm font-extrabold text-[#4d3a2c] dark:text-[#d9c5b5] hover:text-[#2b1f17] dark:hover:text-white hover:bg-[#4d3a2c]/10 dark:hover:bg-[#2b1f17] transition-all duration-200"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Actions (Theme Toggle & Mobile menu) -->
      <div class="flex items-center gap-2">
        <!-- Light Switch Toggle Button with Labels (Compact & Snug Fit) -->
        <button
          id="theme-toggle-btn"
          onclick="toggleTheme()"
          class="relative inline-flex items-center h-9 w-[180px] rounded-full p-1 bg-[#dfcabc] dark:bg-[#231811] border border-[#b8856c]/40 dark:border-[#3d2d22] shadow-inner focus:outline-none transition-colors duration-300 group active:scale-95 shrink-0 select-none overflow-hidden"
          aria-label="Toggle Mode Terang / Mode Gelap"
        >
          <!-- Track Labels with padding so knob fits snugly -->
          <div class="w-full flex justify-between items-center px-2 text-[11px] font-extrabold pointer-events-none z-0">
            <span class="pl-6 text-[#2b1f17] dark:text-[#a89586] transition-colors duration-300">Mode Terang</span>
            <span class="pr-6 text-[#7c6352] dark:text-[#f5eae1] transition-colors duration-300">Mode Gelap</span>
          </div>

          <!-- Sliding Knob (Saklar Digeser) -->
          <div
            class="absolute left-1 top-1 w-7 h-7 rounded-full bg-white dark:bg-[#87533d] shadow-md border border-amber-900/10 dark:border-amber-100/20 transform transition-transform duration-300 ease-out flex items-center justify-center translate-x-0 dark:translate-x-[144px] z-10"
          >
            <span class="dark:hidden text-xs select-none">☀️</span>
            <span class="hidden dark:inline text-xs select-none">🌙</span>
          </div>
        </button>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg text-[#5c4a3b] dark:text-[#e4cdb7] hover:text-[#1c1510] dark:hover:text-white hover:bg-[#f3e3d3]/60 dark:hover:bg-[#33251a] transition-colors"
          aria-label="Toggle menu"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Nav -->
    <nav id="mobile-menu" class="md:hidden hidden pb-4 border-t border-[#e5d4c5] mt-2 pt-4">
      <div class="flex flex-col gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-4 py-2.5 rounded-lg text-sm font-semibold text-[#4a3b30] hover:text-[#1c1510] hover:bg-[#f3e3d3]/60 transition-all"
          >
            {link.label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
