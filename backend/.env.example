# ─── Server ────────────────────────────────────────
SERVER_PORT=8080
ALLOWED_ORIGINS=http://localhost:4321

# ─── PostgreSQL ────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/digitalstore?sslmode=disable

# ─── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ──────────────────────────────────────
# 32-byte hex-encoded key for AES-256-GCM encryption
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_API_KEY=change-me-to-a-strong-random-key
NOTIFICATION_SECRET=change-me-to-a-strong-notification-secret

# ─── Duitku ────────────────────────────────────────
DUITKU_MERCHANT_CODE=DXXXXX
DUITKU_API_KEY=XXXXXXXXXX7968XXXXXXXXXFB05332AF
DUITKU_IS_PRODUCTION=false
DUITKU_CALLBACK_URL=https://yourdomain.com/api/v1/webhooks/duitku
DUITKU_RETURN_URL=https://yourdomain.com/checkout/success

# ─── Resend ────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Digital Store

# ─── Telegram ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCDefghIJKLmnoPQRStuvWXYZ
TELEGRAM_CHAT_ID=-1001234567890
