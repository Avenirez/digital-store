# ─── Server ────────────────────────────────────────
SERVER_PORT=8080
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─── PostgreSQL ────────────────────────────────────
# Ganti dengan URL PostgreSQL Production (misal dari Supabase / Render)
DATABASE_URL=postgres://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?sslmode=require

# ─── Redis ─────────────────────────────────────────
# Ganti dengan URL Redis Production jika menggunakan Redis Cloud
REDIS_URL=redis://default:[PASSWORD]@[HOST]:6379/0

# ─── Security ──────────────────────────────────────
# Kunci Enkripsi AES-256 (Telah Dihasilkan Secara Acak & Aman)
AES_KEY=789be351cb9cbf51cecdd56f19c63b642fc47fa14ce4b8fb58b6c05b8ee5ff39
ADMIN_API_KEY=d2ea38b9df4390ead94530c7be68c15ddf8fe927124d44a0

# ─── Duitku (Payment Gateway) ──────────────────────
# Isi dengan Merchant Code & API Key Production dari Dashboard Duitku
DUITKU_MERCHANT_CODE=YOUR_PRODUCTION_MERCHANT_CODE
DUITKU_API_KEY=YOUR_PRODUCTION_API_KEY
DUITKU_IS_PRODUCTION=true
DUITKU_CALLBACK_URL=https://api.yourdomain.com/api/v1/webhooks/duitku
DUITKU_RETURN_URL=https://yourdomain.com/checkout/success

# ─── Resend (Email Service - Optional) ─────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Lexaa Store

# ─── Telegram Notification (Optional) ──────────────
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
