# ─── Server ────────────────────────────────────────
SERVER_PORT=8080
ALLOWED_ORIGINS=https://lexaastore.cloud,https://www.lexaastore.cloud,http://lexaastore.cloud

# ─── PostgreSQL ────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_ANDA
POSTGRES_DB=digitalstore
DATABASE_URL=postgres://postgres:GANTI_DENGAN_PASSWORD_KUAT_ANDA@postgres:5432/digitalstore?sslmode=disable

# ─── Redis ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Security ──────────────────────────────────────
# 32-byte hex-encoded key for AES-256-GCM encryption (GANTI!)
AES_KEY=GANTI_DENGAN_64_KARAKTER_HEX_RANDOM
ADMIN_API_KEY=GANTI_DENGAN_API_KEY_ADMIN_RAHASIA

# ─── Resend (Email) ───────────────────────────────
# Opsional: Isi jika ingin kirim email kredensial ke pembeli
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@lexaastore.cloud
RESEND_FROM_NAME=Lexaa Store

# ─── Telegram ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=GANTI_DENGAN_BOT_TOKEN
TELEGRAM_CHAT_ID=GANTI_DENGAN_CHAT_ID
