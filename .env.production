# ─── Server ────────────────────────────────────────
SERVER_PORT=8080
ALLOWED_ORIGINS=https://lexaastore.cloud,https://www.lexaastore.cloud,http://lexaastore.cloud

# ─── PostgreSQL ────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_123
POSTGRES_DB=digitalstore
DATABASE_URL=postgres://postgres:postgres_secure_pass_123@postgres:5432/digitalstore?sslmode=disable

# ─── Redis ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Security ──────────────────────────────────────
# 32-byte hex-encoded key for AES-256-GCM encryption
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_API_KEY=admin_secret_key_12345

# ─── Resend (Email) ───────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@lexaastore.cloud
RESEND_FROM_NAME=Lexaa Store

# ─── Telegram ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
